<?xml version="1.0" encoding="utf-8"?>
<!--
  Rutas que el FileProvider puede compartir con otras apps.

  Sólo se expone el cache dir privado de la app: es lo único que necesita
  @capacitor/camera, que escribe la foto temporal en `getCacheDir()` y le pasa
  la URI a la app de cámara (ver CameraPlugin.getUriForFile).

  NO se declara `<external-path path="." />` (el default del template de
  Capacitor): eso mapea la raíz del almacenamiento externo compartido y
  habilitaría a cualquier app con el grant a leer archivos ajenos a STApp.
  Nada del código lo usa — las exportaciones de @capacitor/filesystem escriben
  directo en Directory.Documents sin pasar por el FileProvider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="." />
</paths>
