# Plantilla de config de firma de release.
# Copiá este archivo a android/keystore.properties (gitignored) y completá con
# los datos de TU keystore. NUNCA commitees keystore.properties ni el .jks.
#
# Crear el keystore (una sola vez, guardalo en lugar seguro + backup):
#   keytool -genkey -v -keystore stapp-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias stapp
#
# storeFile: ruta al .jks relativa a android/ (o absoluta).

storeFile=stapp-release.jks
storePassword=TU_STORE_PASSWORD
keyAlias=stapp
keyPassword=TU_KEY_PASSWORD
