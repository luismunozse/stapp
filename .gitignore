# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production.local
.env.vercel
.env.vercel*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor
# android/ se versiona para persistir config de release (firma, permisos, ícono).
# Su propio android/.gitignore excluye build artifacts, keystores y secretos.
/ios/

nul

# Sentry Config File
.env.sentry-build-plugin

# Claude Code worktrees (separate git repos, not submodules)
.claude/worktrees/
shots/

# Local agent tooling (brainstorm scratch, etc.)
.superpowers/

# Playwright runtime auth state (regenerated by e2e/auth.setup.ts)
e2e/.auth/

# Manual PDF visual-sample output (PDF_SAMPLES=1)
.tmp-preview/
