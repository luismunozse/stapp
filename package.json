{
  "name": "stapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:seed": "playwright test --project=setup",
    "test:e2e:firefox": "cross-env PW_FIREFOX=1 playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:install:all": "playwright install --with-deps chromium firefox",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:build:apk": "cd android && gradlew assembleDebug",
    "cap:build:aab": "npx cap sync && cd android && gradlew bundleRelease",
    "cap:build:apk:release": "npx cap sync && cd android && gradlew assembleRelease",
    "cap:upload:apk": "node scripts/upload-apk.mjs",
    "cap:publish:apk": "npx cap sync && cd android && gradlew assembleDebug && cd .. && node scripts/upload-apk.mjs",
    "db:dry": "node scripts/db-run.mjs",
    "db:apply": "node scripts/db-run.mjs --apply"
  },
  "dependencies": {
