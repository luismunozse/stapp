// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usando String en lugar de enum porque SQLite no soporta enums
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  rol       String   // ADMIN o TECNICO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordenesAsignadas OrdenServicio[] @relation("TecnicoOrden")
}

model Cliente {
  id        String         @id @default(cuid())
  nombre    String
  telefono  String
  email     String?
  direccion String?
  dni       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  ordenes OrdenServicio[]
}

model OrdenServicio {
  id                String   @id @default(cuid())
  numeroOrden       Int      @unique // Se manejará manualmente el incremento
  clienteId         String
  tecnicoId         String?
  dispositivo       String
  tipoDispositivo   String   // CELULAR o COMPUTADORA
  problemaReportado String
  estado            String   @default("PENDIENTE") // PENDIENTE, EN_REPARACION, ESPERANDO_REPUESTO, COMPLETADO, ENTREGADO, CANCELADO
  presupuesto       Float?
  costoFinal        Float?
  fechaIngreso      DateTime @default(now())
  fechaPrometida    DateTime?
  fechaCompletado   DateTime?
  observaciones     String?
  diagnostico       String?

  cliente Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tecnico User?     @relation("TecnicoOrden", fields: [tecnicoId], references: [id])
  repuestos         RepuestoOrden[]
  facturas          Factura[]

  @@index([estado])
  @@index([clienteId])
  @@index([tecnicoId])
}

model Inventario {
  id              String   @id @default(cuid())
  codigo          String   @unique
  nombre          String
  descripcion     String?
  categoria       String
  tipoDispositivo String   // CELULAR, COMPUTADORA o AMBOS
  stock           Int      @default(0)
  precioCompra    Float
  precioVenta     Float
  proveedor       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repuestos RepuestoOrden[]

  @@index([categoria])
  @@index([tipoDispositivo])
}

model RepuestoOrden {
  id           String        @id @default(cuid())
  ordenId      String
  inventarioId String
  cantidad     Int
  precioUnitario Float

  orden      OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  inventario Inventario    @relation(fields: [inventarioId], references: [id])

  @@index([ordenId])
  @@index([inventarioId])
}

model Factura {
  id            String   @id @default(cuid())
  ordenId       String   @unique
  numeroFactura String   @unique
  fecha         DateTime @default(now())
  subtotal      Float
  iva           Float
  total         Float
  estadoPago    String   @default("PENDIENTE") // PENDIENTE o PAGADO

  orden OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([numeroFactura])
  @@index([estadoPago])
}
