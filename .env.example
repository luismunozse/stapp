# ========================================
# SUPABASE
# ========================================

# PostgreSQL connection (con PgBouncer para pooling)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (para migraciones)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ========================================
# AUTH
# ========================================

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# Superadmin - emails separados por coma
SUPERADMIN_EMAILS="admin@stapp.com.ar"

# ========================================
# MULTI-TENANT
# ========================================

# Dominio raíz para subdominios (sin https://)
NEXT_PUBLIC_ROOT_DOMAIN="stapp.com.ar"

# Dominio para cookies compartidas entre subdominios
# IMPORTANTE: Debe empezar con punto (.) para incluir subdominios
# En desarrollo local no es necesario
COOKIE_DOMAIN=".stapp.com.ar"

# ========================================
# WEB PUSH (VAPID) — opcional, habilita push al navegador
# ========================================
# Generar con: npx web-push generate-vapid-keys
# Sin estas vars, el push se omite limpiamente (email/WhatsApp/in-app siguen).
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@stapp.com.ar"

# ========================================
# EMAIL (EnvialoSimple)
# ========================================
# Obtén tu API Key en el panel de EnvialoSimple
# Docs: https://api-transaccional.envialosimple.email/

ENVIALOSIMPLE_API_KEY="tu-api-key-aqui"
EMAIL_FROM="noreply@tu-dominio.com"

# ========================================
# CRON (Vercel)
# ========================================

CRON_SECRET="your-cron-secret-for-scheduled-jobs"

# ========================================
# MERCADOPAGO (Pagos)
# ========================================

MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="..."


# ========================================
# REBILL (Pagos internacionales - USD)
# ========================================
# Crear cuenta en https://www.rebill.com
# Obtener API Key en Dashboard > Settings > API Keys

REBILL_API_KEY="..."

# Shared secret para autenticar webhooks entrantes de Rebill.
# Rebill no expone firma HMAC todavía, así que usamos un bearer token:
# se debe configurar en el panel de Rebill como header
#   Authorization: Bearer <token>
# o como `X-Webhook-Token: <token>`. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUERIDO en producción — sin esto, /api/rebill/webhook rechaza todo.
REBILL_WEBHOOK_TOKEN="..."

# ========================================
# GOOGLE LOGIN (OAuth)
# ========================================
# Crear credenciales OAuth 2.0 en https://console.cloud.google.com/apis/credentials
# Tipo: Aplicación web
# Orígenes autorizados: https://stapp.com.ar, https://*.stapp.com.ar
# URIs de redirección: no se necesitan (usamos popup client-side)

NEXT_PUBLIC_GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"

# ========================================
# CHATBOT (Google Gemini)
# ========================================

GOOGLE_GEMINI_API_KEY="tu-api-key-de-google-ai-studio"

# ========================================
# ANALYTICS & ADS
# ========================================

# Google Analytics 4 - Measurement ID
# Obtener en: https://analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Ads - Conversion ID (opcional, para tracking de conversiones)
# Obtener en: https://ads.google.com > Tools > Conversions
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXX"
