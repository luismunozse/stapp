# ========================================
# SUPABASE
# ========================================

# PostgreSQL connection (con PgBouncer para pooling)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (para migraciones)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ========================================
# AUTH
# ========================================

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# ========================================
# MULTI-TENANT
# ========================================

# Dominio raíz para subdominios (sin https://)
NEXT_PUBLIC_ROOT_DOMAIN="stapp.com.ar"

# Dominio para cookies compartidas entre subdominios
# IMPORTANTE: Debe empezar con punto (.) para incluir subdominios
# En desarrollo local no es necesario
COOKIE_DOMAIN=".stapp.com.ar"

# ========================================
# EMAIL (EnvialoSimple)
# ========================================
# Obtén tu API Key en el panel de EnvialoSimple
# Docs: https://api-transaccional.envialosimple.email/

ENVIALOSIMPLE_API_KEY="tu-api-key-aqui"
EMAIL_FROM="noreply@tu-dominio.com"

# ========================================
# BACKGROUND JOBS (Inngest)
# ========================================

INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."

# ========================================
# CRON (Vercel)
# ========================================

CRON_SECRET="your-cron-secret-for-scheduled-jobs"

# ========================================
# MERCADOPAGO (Pagos)
# ========================================

MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# ========================================
# LEMONSQUEEZY (Pagos internacionales - USD)
# ========================================
# Crear cuenta en https://lemonsqueezy.com
# Obtener API Key en Settings > API Keys
# Crear producto con variantes Monthly ($12) y Yearly ($115)

LEMONSQUEEZY_API_KEY="..."
LEMONSQUEEZY_STORE_ID="..."
LEMONSQUEEZY_VARIANT_MONTHLY="..."
LEMONSQUEEZY_VARIANT_YEARLY="..."
LEMONSQUEEZY_WEBHOOK_SECRET="..."

# ========================================
# CHATBOT (Google Gemini)
# ========================================

GOOGLE_GEMINI_API_KEY="tu-api-key-de-google-ai-studio"

# ========================================
# ANALYTICS & ADS
# ========================================

# Google Analytics 4 - Measurement ID
# Obtener en: https://analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Ads - Conversion ID (opcional, para tracking de conversiones)
# Obtener en: https://ads.google.com > Tools > Conversions
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXX"
