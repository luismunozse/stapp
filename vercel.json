{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "app/api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/trial-management",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/engagement",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/feature-usage",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/recordatorios",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/turnos-recordatorios",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-health",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/subscription-sweep",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/re-engagement",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/catalogo-pii-purge",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/catalogo-reservas-vencidas",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/auto-archive-dormant",
      "schedule": "0 5 * * *"
    }
  ]
}
