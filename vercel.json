{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "app/api/inngest/route.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "crons": [
    {
      "path": "/api/inngest",
      "schedule": "0 10 * * *"
    }
  ]
}
